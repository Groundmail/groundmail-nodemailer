{
  "name": "groundmail-nodemailer",
  "version": "0.15.46",
  "description": "Nodemailer transport for Groundmail (HTTP API, not SMTP)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src",
    "!src/**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Groundmail/groundmail-nodemailer.git"
  },
  "homepage": "https://docs.groundmail.dev/frameworks/node",
  "bugs": {
    "url": "https://github.com/Groundmail/groundmail-nodemailer/issues"
  },
  "keywords": [
    "nodemailer",
    "nodemailer-transport",
    "email",
    "transactional",
    "transport",
    "groundmail",
    "smtp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "nodemailer": ">=6.0.0",
    "groundmail": ">=0.13.0"
  },
  "dependencies": {
    "groundmail": "0.52.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "nodemailer": "^10.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external groundmail --external nodemailer --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
